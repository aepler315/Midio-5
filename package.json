{
  "name": "super-maudio-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser music visualizer: drop a song, pick a world, watch it play itself.",
  "scripts": {
    "start": "node tools/serve.js",
    "dev": "node tools/serve.js 8080",
    "lint": "eslint src tools test",
    "test": "node --test test/*.js test/*.mjs test/helpers/*.js",
    "test:all": "node --test",
    "test:smoke": "node tools/smoke.mjs",
    "test:bootstrap": "node tools/bootstrap-smoke.mjs",
    "stage:site": "node tools/stage-site.mjs . _site",
    "test:seek": "node tools/seek-effects-smoke.mjs",
    "test:shading": "node tools/static-shading-smoke.mjs",
    "test:lighting": "node tools/adapted-lighting-smoke.mjs",
    "test:worlds": "node tools/worlds-smoke.mjs",
    "test:chooser": "node tools/smoke-world-chooser.mjs",
    "test:chooser-keyboard": "node tools/chooser-keyboard-smoke.mjs",
    "test:export": "node tools/export-smoke.mjs",
    "test:car": "node tools/car-mode-smoke.mjs",
    "test:urlload": "node tools/url-load-smoke.mjs",
    "music-server": "node tools/music-server.mjs",
    "bench:sections": "node tools/benchmark-segmentation.mjs",
    "eval:worlds": "node tools/evaluate-worlds.mjs",
    "slskd": "docker compose up -d slskd",
    "slskd:down": "docker compose down",
    "slskd:logs": "docker compose logs -f slskd",
    "start:full": "docker compose up -d slskd && node tools/serve.js"
  },
  "dependencies": {
    "slsk-client": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0"
  }
}
